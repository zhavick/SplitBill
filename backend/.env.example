NODE_ENV=development
PORT=4000
# Aplikasi web (frontend) berjalan di port ini
WEB_PORT=3385
WEB_ORIGIN=http://localhost:3385

# Database & Cache (cocok dengan docker-compose.yml)
DATABASE_URL="postgresql://splitbill_admin:splitbill_dev_password@localhost:5578/splitbill_db?schema=public"
REDIS_URL="redis://:splitbill_redis_password@localhost:6379"

# Security & JWT (ganti di produksi, minimal 32 karakter)
JWT_ACCESS_SECRET="dev-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-0123456789abcdef"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Seeder akun superadmin
SEED_ADMIN_EMAIL="admin@splitbill.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Vision AI (Step 4)
GEMINI_API_KEY=""

# Object storage (Step 4)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET_NAME="splitbill-receipts"

# Gateway komunikasi (Step 3)
RESEND_API_KEY=""
EMAIL_SENDER_ADDRESS="no-reply@splitbill.local"
WA_PHONE_NUMBER_ID=""
WA_API_TOKEN=""

# OAuth (Step 3)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_SERVICES_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
