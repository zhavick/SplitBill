    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.3.7",
    "@google/genai": "^3.3.0",
    "@prisma/client": "^6.0.0",
    "@splitbill/shared": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "google-auth-library": "^9.14.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
